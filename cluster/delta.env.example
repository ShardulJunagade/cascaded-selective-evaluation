# Copy this file to cluster/delta.env and fill in ACCOUNT.
# `accounts` on Delta lists the valid project names for your login.
ACCOUNT=""

# Production queues. Each judge uses one NVIDIA GPU.
CPU_PARTITION="cpu"
GPU_PARTITION="gpuA100x4"

# Delta's supported GPU Python/PyTorch environment. Check with:
#   module spider pytorch-conda
PYTHON_MODULE="pytorch-conda/2.8"

# Optional overrides. Empty values use $SCRATCH/cascaded-selective-evaluation.
BULK_ROOT=""
HF_HOME_OVERRIDE=""

# Set to 1 only when data/vlm_v2_export/eval_pool.jsonl has already been built
# and verified. Scoring remains resumable regardless of this setting.
SKIP_DATA="0"
