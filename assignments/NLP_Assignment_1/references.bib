@article{YAO2026116569,
title = {A survey on audio–visual large language models},
journal = {Knowledge-Based Systems},
volume = {350},
pages = {116569},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116569},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126012955},
author = {Wenyi Yao and Roksana Yahyaabadi and Hossein Hassani and Soodeh Nikan},
keywords = {Audio–visual systems, Large language models, Multimodal learning, Vision-language models},
abstract = {Human cognition inherently combines information from multiple senses, motivating artificial intelligence (AI) systems that can jointly process temporally dynamic and semantically rich inputs for naturalistic interactions. Although vision–language models (VLMs) have demonstrated remarkable achievements in learning aligned vision and text embeddings for cross-modal retrieval and generation, integrating audio into this process complements the temporal cues for enriched contextual understanding. In this context, audio–visual large language models (AV-LLMs) mark a significant progression in multimodal representation learning through joint encoding and cross-modal alignment of auditory, visual, and linguistic modalities. This survey is the first of its kind to address the gap between existing VLM surveys and the integration of audio as an additional modality. In particular, this survey presents a comprehensive overview of AV-LLMs by systematically categorizing model architectures, training objectives, and available datasets. We identify current methodological trends, limitations, and downstream applications, including audio and video captioning, multimodal conversational AI, and cross-modal retrieval. Finally, we outline key challenges and future research directions to advance the development of robust and generalizable multimodal language models. Resources are available at https://github.com/AiX-Lab-UWO/Audio-Visual-LLMs-Survey.}
}